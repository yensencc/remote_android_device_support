# Headwind Remote (aPuppet): web console + Janus APIs (HTTP and WebSockets on loopback).
server {
    listen 80;
    listen [::]:80;
    server_name ${REMOTE_DOMAIN};
    location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${REMOTE_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${REMOTE_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${REMOTE_DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/remote-support-tls.conf;

    location = / { return 302 /web-admin/; }

    # The console contains the Janus API secret, so it's behind a login.
    location ^~ /web-admin/ {
        auth_basic "Remote support";
        auth_basic_user_file /etc/nginx/remote-support.htpasswd;
        alias ${INSTALL_DIR}/generated/web-admin/;
        index index.html;
    }

    # Janus REST API (agents and console). Every request must carry the API secret.
    location ^~ /janus {
        proxy_pass http://127.0.0.1:8088/janus;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 90s;   # long polls
        proxy_buffering off;
    }

    # Janus WebSockets API (console).
    location = /janus-ws {
        proxy_pass http://127.0.0.1:8188;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Sec-WebSocket-Protocol $http_sec_websocket_protocol;
        proxy_read_timeout 3600s;
    }
}
