# Copy to .env and fill in the first block. install.sh generates every empty secret
# and writes it back to .env (chmod 600). Never commit .env.

# --- Required ---------------------------------------------------------------
# DNS A records for both must point to this server before running install.sh.
MDM_DOMAIN=mdm.example.com
REMOTE_DOMAIN=remote.example.com
# Let's Encrypt notices and the MDM admin account email.
ADMIN_EMAIL=admin@example.com

# --- Generated by install.sh when empty -------------------------------------
SQL_PASS=
# Headwind MDM shared secret. Must equal the value compiled into the MDM agent APK;
# the stock agent uses changeme-C3z9vi54 (install.sh sets that when empty). A mismatch
# breaks push: "User name [hmdm] or password is invalid" in the hmdm log.
SHARED_SECRET=
# Janus API secret: entered in the remote-control agent's "Secret" field.
JANUS_API_SECRET=
JANUS_ADMIN_SECRET=
# Login for the remote-control web console (nginx basic auth).
REMOTE_ADMIN_USER=support
REMOTE_ADMIN_PASS=

# --- Optional ---------------------------------------------------------------
# Public IPv4 of this server (auto-detected when empty).
PUBLIC_IP=
# UDP ports for screen video (device -> server RTP, server -> browser WebRTC).
# About 4 ports per simultaneous session; 40 ports = ~10 sessions.
RTP_PORT_RANGE=20000-20039
# Memory: Java heap for Headwind MDM and the container cap (1 GB server: 384m / 640m;
# 2 GB+: 512m / 900m).
TOMCAT_MAX_HEAP=384m
HMDM_MEM_LIMIT=640m
# Swap file created by install.sh if the server has none (0 = skip).
SWAP_SIZE=2G
# Pinned versions (see THIRD_PARTY.md before changing).
HMDM_IMAGE=headwindmdm/hmdm:0.1.9
HMDM_URL=https://h-mdm.com/files/hmdm-5.41.1-os.war
CLIENT_VERSION=6.40
JANUS_IMAGE=headwindmdm/janus-gateway:0.10.7
POSTGRES_IMAGE=postgres:15-alpine
# Set to true for one start after changing MDM_DOMAIN/secrets, then clear it.
FORCE_RECONFIGURE=
