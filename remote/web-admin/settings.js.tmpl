// Opaque ids
var opaqueId = Janus.randomString(12);
var streamingOpaqueId = "streaming-" + opaqueId;
var textroomOpaqueId = "textroom-" + opaqueId;

// Janus
var apiSecret = "${JANUS_API_SECRET}";

var janusDebugLevel = ['warn', 'error'];

// Toastr options
toastr.options = {
    "closeButton": false,
    "debug": false,
    "newestOnTop": false,
    "progressBar": true,
    "positionClass": "toast-top-right",
    "preventDuplicates": true,

    "showDuration": 1,
    "hideDuration": 1000,
    "timeOut": 5000,
    "extendedTimeOut": 0,

    "showEasing": "swing",
    "hideEasing": "linear",
    "showMethod": "fadeIn",
    "hideMethod": "fadeOut",

    "onclick": null,
    "onHidden": null,
}

// Janus servers (tried in order)
function getJanusServers() {
    return [
        `wss://${window.location.host}/janus-ws`,
        `https://${window.location.host}/janus`,
    ];
}

var janusServers = getJanusServers();
